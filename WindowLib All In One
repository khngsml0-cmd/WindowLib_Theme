		WindowAPI:BindContextMenu(TopBar, config.TopBarContextMenu, config.TopBarContextMenuTrigger or "Right")
	end

	return WindowAPI
end

--------------------------------------------------------------------------------
-- GLOBAL THEME & RESET HỆ THỐNG AN TOÀN
--------------------------------------------------------------------------------
function Library:SetTheme(themeName)
	if type(themeName) ~= "string" then return end
	local lower = string.lower(themeName)
	local targetName = "Dark"

	if lower == "light" or lower == "trang" or lower == "sáng" or lower == "sang" then targetName = "Light"
	elseif lower == "dark" or lower == "den" or lower == "tối" or lower == "toi" then targetName = "Dark"
	elseif lower == "classic" or lower == "retro" or lower == "2016" or lower == "codien" or lower == "cổ điển" then targetName = "Classic" end

	local oldThemeName = currentThemeName
	local isTransitioningArchetype = (Themes[oldThemeName].Type ~= Themes[targetName].Type)

	currentThemeName = targetName
	currentTheme = Themes[targetName]

	if isTransitioningArchetype then
		-- 1. HỦY DỨT ĐIỂM (INSTANT DESTROY) toàn bộ GUI cửa sổ cũ, không chờ Tween animation
		for _, win in ipairs(activeWindowsList) do
			if win.Frame and win.Frame.Parent then
				win.Frame:Destroy() -- Xóa thẳng GUI cũ ngay lập tức
			end
		end

		-- 2. Dọn sạch toàn bộ danh sách trạng thái
		activeWindowsList = {}
		minimizedWindowsList = {}
		mruWindowsList = {}
		desktopMinimizedStack = {}
		currentlyFocusedWindow = nil

		-- 3. Xử lý thanh Taskbar
		if targetName == "Classic" then
			updateClassicTaskbar()
		else
			ClassicTaskbar.Visible = false
			UnHideTaskbar.Visible = false
		end

		-- 4. TỰ ĐỘNG TẠO LẠI (AUTO-REBUILD) TOÀN BỘ CỬA SỔ THEO THEME MỚI
		local oldRegistry = registeredWindowsRegistry
		registeredWindowsRegistry = {} -- Reset để tránh bị duplicate khi CreateWindow lại

		for _, item in ipairs(oldRegistry) do
			local savedConfig = item.Config
			savedConfig._isRebuilding = true -- Cờ báo hiệu đang rebuild
			
			local newWinAPI = Library:CreateWindow(savedConfig)
			
			-- Nếu có hàm Builder vẽ nội dung, tự động gọi lại để vẽ vào Container mới
			if item.Builder and type(item.Builder) == "function" then
				item.Builder(newWinAPI:GetContainer(), newWinAPI)
			end
			
			savedConfig._isRebuilding = nil
			table.insert(registeredWindowsRegistry, item)
		end
	else
		-- Nếu chỉ đổi giữa Dark và Light (cùng kiến trúc Modern) thì chỉ cần update màu sắc
		for _, win in ipairs(activeWindowsList) do
			if win and win.UpdateTheme then win.UpdateTheme(currentTheme) end
		end
		if targetName == "Classic" then updateClassicTaskbar() end
	end

	Library.OnThemeChanged:Fire(targetName, isTransitioningArchetype)
end

function Library:GetTheme() return currentThemeName end
function Library:SetRounded(rounded)
	for _, win in ipairs(activeWindowsList) do
		if win and win.SetRounded then win.SetRounded(rounded) end
	end
end


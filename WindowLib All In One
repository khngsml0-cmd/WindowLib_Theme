	btn.Size = size or UDim2.new(0, 75, 0, 23)
	btn.Position = pos or UDim2.new(0, 0, 0, 0)
	btn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = parent

	local borderTop = Instance.new("Frame", btn)
	borderTop.Size = UDim2.new(1, 0, 0, 1); borderTop.Position = UDim2.new(0, 0, 0, 0); borderTop.BackgroundColor3 = Color3.fromRGB(255, 255, 255); borderTop.BorderSizePixel = 0
	local borderLeft = Instance.new("Frame", btn)
	borderLeft.Size = UDim2.new(0, 1, 1, 0); borderLeft.Position = UDim2.new(0, 0, 0, 0); borderLeft.BackgroundColor3 = Color3.fromRGB(255, 255, 255); borderLeft.BorderSizePixel = 0
	local borderBottom = Instance.new("Frame", btn)
	borderBottom.Size = UDim2.new(1, 0, 0, 1); borderBottom.Position = UDim2.new(0, 0, 1, -1); borderBottom.BackgroundColor3 = Color3.fromRGB(105, 105, 105); borderBottom.BorderSizePixel = 0
	local borderRight = Instance.new("Frame", btn)
	borderRight.Size = UDim2.new(0, 1, 1, 0); borderRight.Position = UDim2.new(1, -1, 0, 0); borderRight.BackgroundColor3 = Color3.fromRGB(105, 105, 105); borderRight.BorderSizePixel = 0

	local btnText = Instance.new("TextLabel", btn)
	btnText.Name = "Text"
	btnText.Size = UDim2.new(1, 0, 1, 0)
	btnText.BackgroundTransparency = 1
	btnText.Font = Enum.Font.SourceSans
	btnText.TextSize = 14
	btnText.TextColor3 = Color3.fromRGB(0, 0, 0)
	btnText.Text = text

	local isHover = false; local isDown = false
	local function setPressed(pressed)
		if pressed then
			borderTop.BackgroundColor3 = Color3.fromRGB(105, 105, 105); borderLeft.BackgroundColor3 = Color3.fromRGB(105, 105, 105)
			borderBottom.BackgroundColor3 = Color3.fromRGB(255, 255, 255); borderRight.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			btnText.Position = UDim2.new(0, 1, 0, 1); btn.BackgroundColor3 = Color3.fromRGB(225, 225, 225)
		else
			borderTop.BackgroundColor3 = Color3.fromRGB(255, 255, 255); borderLeft.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			borderBottom.BackgroundColor3 = Color3.fromRGB(105, 105, 105); borderRight.BackgroundColor3 = Color3.fromRGB(105, 105, 105)
			btnText.Position = UDim2.new(0, 0, 0, 0); btn.BackgroundColor3 = isHover and Color3.fromRGB(248, 248, 248) or Color3.fromRGB(240, 240, 240)
		end
	end

	btn.MouseEnter:Connect(function() isHover = true; if not isDown then btn.BackgroundColor3 = Color3.fromRGB(248, 248, 248) end end)
	btn.MouseLeave:Connect(function() isHover = false; if not isDown then btn.BackgroundColor3 = Color3.fromRGB(240, 240, 240) end end)
	btn.MouseButton1Down:Connect(function() isDown = true; setPressed(true) end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isDown then isDown = false; setPressed(false) end
		end
	end)

	btn.MouseButton1Click:Connect(function() if callback then callback() end end)
	return btn
end


local activeSubmenuFrames = {}

local function setWindowFocusState(winRecord)
	if currentlyFocusedWindow == winRecord then return end

	if currentlyFocusedWindow and currentlyFocusedWindow.SetFocusVisual then
		currentlyFocusedWindow.SetFocusVisual(false)
	end

	currentlyFocusedWindow = winRecord

	if winRecord then
		if winRecord.SetFocusVisual then winRecord.SetFocusVisual(true) end
		for i, w in ipairs(mruWindowsList) do
			if w == winRecord then table.remove(mruWindowsList, i); break end
		end
		table.insert(mruWindowsList, 1, winRecord)
	end

	if currentThemeName == "Classic" then
		updateClassicTaskbar()
	end
end

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if currentlyFocusedWindow == nil then return end

		local rawMousePos = UserInputService:GetMouseLocation()
		local guiInset = GuiService:GetGuiInset()
		local mousePos = Vector2.new(rawMousePos.X, rawMousePos.Y - guiInset.Y)

		for _, f in ipairs(activeSubmenuFrames) do
			if f and f.Parent then
				local fPos = f.AbsolutePosition; local fSize = f.AbsoluteSize
				if mousePos.X >= fPos.X and mousePos.X <= fPos.X + fSize.X and mousePos.Y >= fPos.Y and mousePos.Y <= fPos.Y + fSize.Y then
					return
				end
			end
		end

		if ClassicTaskbar.Visible then
			local tbPos = ClassicTaskbar.AbsolutePosition
			local tbSize = ClassicTaskbar.AbsoluteSize
			if mousePos.X >= tbPos.X and mousePos.X <= tbPos.X + tbSize.X and mousePos.Y >= tbPos.Y and mousePos.Y <= tbPos.Y + tbSize.Y then
				return
			end
		end

		local clickedInsideAny = false
		for _, win in ipairs(activeWindowsList) do
			if win.Frame and win.Frame.Parent and win.Frame.Visible then
				local pos = win.Frame.AbsolutePosition
				local size = win.Frame.AbsoluteSize
				if mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y then
					clickedInsideAny = true
					break
				end
			end
		end

		if not clickedInsideAny then
			setWindowFocusState(nil)
		end
	end
end)

